---
import { getCollection } from 'astro:content';
import { getApiReferenceMarkdown } from '../lib/apiReferenceMarkdown';

const pathname = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const markdownUrl = `/${pathname || 'index'}.md`;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const page = (await getCollection('docs')).find((entry) => entry.id === (pathname || 'index'));
const markdownSource = page?.body ?? getApiReferenceMarkdown(Astro.url.pathname) ?? '';
---

<div class="page-actions" data-page-actions data-markdown-url={markdownUrl} data-page-url={pageUrl} data-markdown={markdownSource}>
  <div class="page-actions-trigger">
    <button class="page-actions-copy-trigger" type="button" data-copy-primary>
      <span class="page-actions-trigger-label">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path class="check-icon" d="m5 12 4 4L19 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
          <rect class="copy-icon" x="8" y="8" width="11" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7" />
          <path class="copy-icon" d="M16 8V6.5A1.5 1.5 0 0 0 14.5 5h-8A1.5 1.5 0 0 0 5 6.5v8A1.5 1.5 0 0 0 6.5 16H8" fill="none" stroke="currentColor" stroke-width="1.7" />
        </svg>
        <span data-copy-label>Copy Page</span>
      </span>
    </button>
    <button class="page-actions-menu-trigger" type="button" aria-expanded="false" aria-haspopup="menu" aria-label="Open page actions menu">
      <span class="page-actions-chevron" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
        </svg>
      </span>
    </button>
  </div>

  <div class="page-actions-menu" role="menu" hidden>
    <button class="page-action" type="button" role="menuitem" data-copy-page>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path class="check-icon" d="m5 12 4 4L19 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
        <rect class="copy-icon" x="8" y="8" width="11" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7" />
        <path class="copy-icon" d="M16 8V6.5A1.5 1.5 0 0 0 14.5 5h-8A1.5 1.5 0 0 0 5 6.5v8A1.5 1.5 0 0 0 6.5 16H8" fill="none" stroke="currentColor" stroke-width="1.7" />
      </svg>
      <span>
        <strong>Copy Page</strong>
        <small>Copy Page as Markdown for LLMs</small>
      </span>
    </button>

    <a class="page-action" role="menuitem" href={markdownUrl} target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M6 10h3M6 14h5M14 10h4M14 14h4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" />
      </svg>
      <span>
        <strong>
          View as Markdown
          <svg class="external-arrow-icon" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" />
          </svg>
        </strong>
        <small>Open this page as plain text</small>
      </span>
    </a>

    <div class="page-action-divider" role="separator"></div>

    <button class="page-action" type="button" role="menuitem" data-open-app="chatgpt">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22.28 9.82a5.98 5.98 0 0 0-.52-4.91 6.05 6.05 0 0 0-6.51-2.9A6.07 6.07 0 0 0 4.98 4.18a5.98 5.98 0 0 0-4 2.9 6.05 6.05 0 0 0 .74 7.1 5.98 5.98 0 0 0 .51 4.91 6.05 6.05 0 0 0 6.51 2.9A5.98 5.98 0 0 0 13.26 24a6.06 6.06 0 0 0 5.77-4.21 5.99 5.99 0 0 0 4-2.9 6.06 6.06 0 0 0-.75-7.07zm-9.02 12.61a4.48 4.48 0 0 1-2.88-1.04l.14-.08 4.78-2.76a.79.79 0 0 0 .39-.68v-6.74l2.02 1.17a.07.07 0 0 1 .04.05v5.58a4.5 4.5 0 0 1-4.49 4.49zM3.6 18.3a4.47 4.47 0 0 1-.53-3.01l.14.09 4.78 2.76a.77.77 0 0 0 .78 0l5.84-3.37v2.33a.08.08 0 0 1-.03.06l-4.84 2.79A4.5 4.5 0 0 1 3.6 18.3zM2.34 7.9a4.49 4.49 0 0 1 2.37-1.97v5.68a.77.77 0 0 0 .39.68l5.81 3.35-2.02 1.17a.08.08 0 0 1-.07 0l-4.83-2.79A4.5 4.5 0 0 1 2.34 7.87zm16.6 3.86-5.83-3.39 2.02-1.16a.08.08 0 0 1 .07 0l4.83 2.79a4.49 4.49 0 0 1-.68 8.1v-5.68a.79.79 0 0 0-.41-.67zm2.01-3.02-.14-.09-4.77-2.78a.78.78 0 0 0-.79 0L9.41 9.23V6.9a.07.07 0 0 1 .03-.06l4.83-2.79a4.5 4.5 0 0 1 6.68 4.66zM8.31 12.86l-2.02-1.16a.08.08 0 0 1-.04-.06V6.07a4.5 4.5 0 0 1 7.38-3.45l-.14.08-4.78 2.76a.79.79 0 0 0-.39.68zm1.1-2.37 2.6-1.5 2.61 1.5v3l-2.6 1.5-2.61-1.5Z" fill="currentColor" />
      </svg>
      <span>
        <strong>Open in ChatGPT <svg class="external-arrow-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" /></svg></strong>
        <small>Ask Questions About This Page</small>
      </span>
    </button>

    <button class="page-action" type="button" role="menuitem" data-open-app="claude">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.3041 3.541h-3.6718l6.696 16.918H24Zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z" fill="currentColor" />
      </svg>
      <span>
        <strong>Open in Claude <svg class="external-arrow-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" /></svg></strong>
        <small>Ask Questions About This Page</small>
      </span>
    </button>

    <button class="page-action" type="button" role="menuitem" data-open-app="gemini">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M11.04 19.32Q12 21.51 12 24q0-2.49.93-4.68.96-2.19 2.58-3.81t3.81-2.55Q21.51 12 24 12q-2.49 0-4.68-.93a12.3 12.3 0 0 1-3.81-2.58 12.3 12.3 0 0 1-2.58-3.81Q12 2.49 12 0q0 2.49-.96 4.68-.93 2.19-2.55 3.81a12.3 12.3 0 0 1-3.81 2.58Q2.49 12 0 12q2.49 0 4.68.96 2.19.93 3.81 2.55t2.55 3.81" fill="currentColor" />
      </svg>
      <span>
        <strong>Open in Gemini <svg class="external-arrow-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" /></svg></strong>
        <small>Ask Questions About This Page</small>
      </span>
    </button>

    <button class="page-action" type="button" role="menuitem" data-open-app="perplexity">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22.3977 7.0896h-2.3106V.0676l-7.5094 6.3542V.1577h-1.1554v6.1966L4.4904 0v7.0896H1.6023v10.3976h2.8882V24l6.932-6.3591v6.2005h1.1554v-6.0469l6.9318 6.1807v-6.4879h2.8882V7.0896zm-3.4657-4.531v4.531h-5.355l5.355-4.531zM5.646 2.6266l4.8691 4.463H5.6458V2.6262zM2.7576 16.332V8.245h7.8476l-6.1149 6.1147v1.9723H2.7576zm2.8882 5.0404v-3.8852l5.7764-5.2993v7.0111l-5.7764 5.2993zm12.7086.0248-5.7766-5.1509V9.0618l5.7766 5.7766v6.5588zm2.8882-5.0652h-1.733v-1.9723L13.3948 8.245h7.8478v8.087z" fill="currentColor" />
      </svg>
      <span>
        <strong>Open in Perplexity <svg class="external-arrow-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" /></svg></strong>
        <small>Ask Questions About This Page</small>
      </span>
    </button>
  </div>
</div>

<style>
  .page-actions {
    position: relative;
    z-index: 2;
    display: flex;
    width: 100%;
    justify-content: flex-start;
    margin-bottom: 1rem;
  }

  .page-actions-trigger {
    display: inline-flex;
    align-items: stretch;
    height: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    overflow: hidden;
    color: var(--color-text);
    background: var(--color-surface);
  }

  .page-actions-copy-trigger,
  .page-actions-menu-trigger {
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .page-actions-menu-trigger {
    padding-inline: 0.5rem;
    border-inline-start: 1px solid var(--color-border);
  }

  .page-actions-copy-trigger {
    padding: 0;
    width: 7rem;
    font-size: 0.75rem;
  }

  .page-actions-copy-trigger:hover,
  .page-actions-menu-trigger:hover,
  .page-actions-menu-trigger[aria-expanded='true'] {
    background: var(--color-surface-alt);
  }

  .page-actions-trigger-label,
  .page-actions-chevron {
    display: inline-flex;
    align-items: center;
  }

  .page-actions-trigger-label {
    gap: 0.375rem;
    padding-inline: 0.625rem;
  }

  .page-actions-trigger-label svg {
    display: block;
    width: 1rem;
    height: 1rem;
    transform: translateY(0.1rem);
  }

  .check-icon {
    display: none;
  }

  .page-actions[data-copied='true'] .copy-icon {
    display: none;
  }

  .page-actions[data-copied='true'] .check-icon {
    display: block;
  }

  .page-actions-chevron {
    display: inline-flex;
    align-items: center;
    height: 100%;
  }

  .page-actions-chevron svg {
    width: 1rem;
    height: 1rem;
    transition: transform 160ms ease;
  }

  .page-actions-menu-trigger[aria-expanded='true'] .page-actions-chevron svg {
    transform: rotate(180deg);
  }

  .page-actions-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    box-sizing: border-box;
    width: 18rem;
    max-width: 100%;
    padding: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.28);
  }

  .page-action {
    display: grid;
    grid-template-columns: 1.875rem minmax(0, 1fr);
    align-items: start;
    gap: 0.5rem;
    box-sizing: border-box;
    width: 100%;
    padding: 0.5rem 0.625rem;
    border: 0;
    border-radius: 0.5rem;
    color: var(--color-text);
    background: transparent;
    text-align: start;
    text-decoration: none;
    font: inherit;
    cursor: pointer;
  }

  .page-action:hover,
  .page-action:focus-visible {
    background: var(--color-surface-alt);
    outline: none;
  }

  .page-action > svg {
    box-sizing: border-box;
    width: 1.875rem;
    height: 1.875rem;
    padding: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    color: var(--color-text-muted);
  }

  .page-action > svg .check-icon {
    width: auto;
    height: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
  }

  .page-action span {
    position: relative;
    top: -0.125rem;
    display: grid;
    gap: 0.125rem;
  }

  .page-action strong {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .page-action .external-arrow-icon {
    display: block;
    flex: 0 0 auto;
    width: 0.75rem;
    height: 0.75rem;
    color: var(--color-text-muted);
  }

  .page-action small {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .page-action-divider {
    height: 1px;
    margin: 0.375rem 0.625rem;
    background: var(--color-border);
  }

</style>

<script>
  const closeMenus = (except?: HTMLElement): void => {
    document.querySelectorAll<HTMLElement>('[data-page-actions]').forEach((actions) => {
      if (actions === except) return;
      const trigger = actions.querySelector<HTMLButtonElement>('.page-actions-menu-trigger');
      const menu = actions.querySelector<HTMLElement>('.page-actions-menu');
      trigger?.setAttribute('aria-expanded', 'false');
      if (menu) menu.hidden = true;
    });
  };

  document.querySelectorAll<HTMLElement>('[data-page-actions]').forEach((actions) => {
    const trigger = actions.querySelector<HTMLButtonElement>('.page-actions-menu-trigger');
    const menu = actions.querySelector<HTMLElement>('.page-actions-menu');
    const primaryCopyButton = actions.querySelector<HTMLButtonElement>('[data-copy-primary]');
    const copyButton = actions.querySelector<HTMLButtonElement>('[data-copy-page]');
    const copyLabel = actions.querySelector<HTMLElement>('[data-copy-label]');
    const appButtons = actions.querySelectorAll<HTMLButtonElement>('[data-open-app]');
    const markdownUrl = actions.dataset.markdownUrl;
    if (!trigger || !menu || !primaryCopyButton || !copyButton || !copyLabel || !markdownUrl) return;

    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      closeMenus(expanded ? undefined : actions);
      trigger.setAttribute('aria-expanded', String(!expanded));
      menu.hidden = expanded;
    });

    const copyText = async (text: string): Promise<void> => {
      if (!navigator.clipboard?.writeText) {
        throw new Error('Clipboard API is unavailable in this browser context');
      }
      await navigator.clipboard.writeText(text);
    };

    const copyPage = async (): Promise<void> => {
      try {
        let text = actions.dataset.markdown;
        if (!text) {
          const response = await fetch(markdownUrl);
          if (!response.ok) throw new Error('Unable to fetch the page source');
          text = await response.text();
        }
        await copyText(text);
        actions.dataset.copied = 'true';
        copyLabel.textContent = 'Copied';
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        window.setTimeout(() => {
          delete actions.dataset.copied;
          copyLabel.textContent = 'Copy Page';
        }, 1600);
      } catch {
        delete actions.dataset.copied;
        copyLabel.textContent = 'Copy Failed';
        window.setTimeout(() => {
          copyLabel.textContent = 'Copy Page';
        }, 1600);
      }
    };

    primaryCopyButton.addEventListener('click', () => void copyPage());
    copyButton.addEventListener('click', () => void copyPage());

    const appUrls: Record<string, { href: string; parameter: 'prompt' | 'q' }> = {
      chatgpt: { href: 'https://chatgpt.com/', parameter: 'prompt' },
      claude: { href: 'https://claude.ai/new', parameter: 'q' },
      gemini: { href: 'https://gemini.google.com/app', parameter: 'q' },
      perplexity: { href: 'https://www.perplexity.ai/search', parameter: 'q' },
    };

    appButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const app = button.dataset.openApp;
        if (!app) return;
        const appConfig = appUrls[app];
        if (!appConfig) return;
        const pageUrl = actions.dataset.pageUrl ?? new URL(window.location.pathname, window.location.origin).toString();
        const prompt = `Read from ${pageUrl} so I can ask questions about it.`;
        const appUrl = new URL(appConfig.href);
        appUrl.searchParams.set(appConfig.parameter, prompt);
        window.open(appUrl.toString(), '_blank', 'noopener,noreferrer');
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      });
    });
  });

  document.addEventListener('click', (event) => {
    if (event.target instanceof Element && !event.target.closest('[data-page-actions]')) closeMenus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeMenus();
  });
</script>
