---
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';
import PageActions from './PageActions.astro';
---

{
  <>
    {Astro.locals.starlightRoute.toc && (
      <div class="lg:sl-hidden">
        <MobileTableOfContents />
      </div>
    )}
    <div class="mobile-page-actions lg:sl-hidden">
      <PageActions />
    </div>
    <div class="right-sidebar-panel sl-hidden lg:sl-block">
      <div class="sl-container">
        <PageActions />
        {Astro.locals.starlightRoute.toc && <TableOfContents />}
      </div>
    </div>
  </>
}

<style>
  .right-sidebar-panel {
    padding: 1rem var(--sl-sidebar-pad-x);
  }

  .mobile-page-actions {
    display: none;
    padding: 1rem var(--sl-content-pad-x) 0;
  }

  .sl-container {
    width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
  }

  .right-sidebar-panel :global(h2) {
    color: var(--sl-color-white);
    font-size: var(--sl-text-h5);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    margin-bottom: 0.5rem;
  }

  .right-sidebar-panel :global(:where(a:not(.page-action))) {
    display: block;
    font-size: var(--sl-text-xs);
    text-decoration: none;
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }

  .right-sidebar-panel :global(:where(a:not(.page-action)):hover) {
    color: var(--sl-color-white);
  }

  .right-sidebar-panel :global(starlight-toc a[aria-current='true']) {
    color: var(--sl-color-text-accent);
  }

  .right-sidebar-panel :global(starlight-toc li:has(> a[href='#_top'])) {
    display: none;
  }

  @media (max-width: 71.99rem) {
    .mobile-page-actions {
      display: block;
      padding: 0.5rem var(--sl-content-pad-x) 0.75rem;
    }

    .mobile-page-actions :global(.page-actions) {
      margin-bottom: 0;
    }

    :global(mobile-starlight-toc nav) {
      position: relative;
      top: auto;
      inset-inline: auto;
      z-index: auto;
      margin-top: 0.75rem;
      border-top: 0;
      background: transparent;
      box-shadow: none;
    }

    :global(mobile-starlight-toc summary) {
      height: auto;
      min-height: 3rem;
      gap: 0;
      border-bottom: 0;
      padding: 0.375rem var(--sl-content-pad-x);
    }

    :global(mobile-starlight-toc summary .toggle) {
      width: 100%;
      height: 2.25rem;
      border-color: var(--color-border);
      border-radius: 0.5rem;
      padding-block: 0.5rem;
      padding-inline: 0.75rem;
      background: var(--color-surface-alt);
      color: var(--color-text);
      text-transform: capitalize;
    }

    :global(mobile-starlight-toc summary .display-current) {
      display: none;
    }

    :global(mobile-starlight-toc details[open] summary) {
      padding-bottom: 0;
    }

    :global(mobile-starlight-toc details[open] summary .toggle) {
      border-bottom-right-radius: 0;
      border-bottom-left-radius: 0;
    }

    :global(mobile-starlight-toc .dropdown) {
      margin: 0 var(--sl-content-pad-x) 0.5rem;
      border: 1px solid var(--color-border);
      border-top: 0;
      border-radius: 0 0 0.5rem 0.5rem;
      background: var(--color-surface-alt);
      box-shadow: none;
    }

    :global(mobile-starlight-toc .dropdown a) {
      border-radius: 0;
      color: var(--color-text);
    }
  }

  @media (min-width: 72rem) {
    .sl-container {
      max-width: calc(
        (
          (100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
            var(--sl-sidebar-pad-x)) * 0.25
        )
      );
    }
  }
</style>
